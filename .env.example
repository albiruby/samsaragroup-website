# Sanity
# Production. Vercel Preview uses "staging" (set in Vercel, not here).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Site — domain produksi. WAJIB sesuai domain yang benar-benar online.
# Default di src/lib/site.js adalah https://samsaragroup.vercel.app
# Ganti ke domain custom begitu sudah terhubung & terverifikasi.
NEXT_PUBLIC_SITE_URL=https://samsaragroup.vercel.app
